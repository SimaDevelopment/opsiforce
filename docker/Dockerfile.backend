FROM node:24.18.0-alpine AS builder

ARG PKG_PREFIX=packages/opsiforce/

RUN apk add --no-cache python3 make g++

WORKDIR /app

COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/releases .yarn/releases

COPY ${PKG_PREFIX}backend/ ./packages/opsiforce/backend/

WORKDIR packages/opsiforce/backend
RUN yarn install
RUN yarn run build
RUN yarn run db:generate

FROM node:24.18.0-alpine AS server

ARG PKG_PREFIX=packages/opsiforce/

WORKDIR /app

COPY --from=builder /app/.yarn ./.yarn
COPY --from=builder /app/.pnp.* ./
COPY package.json yarn.lock .yarnrc.yml ./

COPY --from=builder /app/packages/opsiforce/backend/dist ./packages/opsiforce/backend/dist
COPY --from=builder /app/packages/opsiforce/backend/db ./packages/opsiforce/backend/db
COPY --from=builder /app/packages/opsiforce/backend/package.json ./packages/opsiforce/backend/package.json
COPY ${PKG_PREFIX}backend/platform-version.json ./packages/opsiforce/backend/platform-version.json
COPY ${PKG_PREFIX}frontend/opencode/packages/protocol/openapi.json ./packages/opsiforce/frontend/opencode/packages/protocol/openapi.json
COPY ${PKG_PREFIX}agent-config/ ./packages/opsiforce/agent-config/

WORKDIR /app/packages/opsiforce/backend/

ENV NODE_ENV="production"
ENV NODE_OPTIONS="--max-http-header-size=128000"

RUN apk add --no-cache git attr

RUN apk add --no-cache python3 make g++ && \
    yarn workspaces focus --all --production && \
    apk del python3 make g++

EXPOSE 3001

CMD ["yarn", "run", "start"]
