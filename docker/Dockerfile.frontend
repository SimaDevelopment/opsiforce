FROM node:24.18.0-alpine

ARG PKG_PREFIX=packages/opsiforce/

WORKDIR /app

ENV NODE_OPTIONS="--max-http-header-size=128000"

COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn
COPY ${PKG_PREFIX}frontend ./packages/opsiforce/frontend

RUN yarn workspaces focus --all

WORKDIR /app/packages/opsiforce/frontend

ARG VITE_WEBAPP_DOMAIN=localhost:3002
ENV VITE_WEBAPP_DOMAIN=$VITE_WEBAPP_DOMAIN
ARG VITE_WEBAPP_PREVIEW_DOMAIN=
ENV VITE_WEBAPP_PREVIEW_DOMAIN=$VITE_WEBAPP_PREVIEW_DOMAIN
ARG VITE_VSCODE_DOMAIN=localhost:3003
ENV VITE_VSCODE_DOMAIN=$VITE_VSCODE_DOMAIN
ARG VITE_DB_DOMAIN=localhost:3004
ENV VITE_DB_DOMAIN=$VITE_DB_DOMAIN
ARG VITE_BRAND_NAME=
ENV VITE_BRAND_NAME=$VITE_BRAND_NAME
ARG VITE_BRAND_ICON=
ENV VITE_BRAND_ICON=$VITE_BRAND_ICON
ARG VITE_BRAND_MANIFEST=
ENV VITE_BRAND_MANIFEST=$VITE_BRAND_MANIFEST
ARG VITE_BRAND_THEME_COLOR=
ENV VITE_BRAND_THEME_COLOR=$VITE_BRAND_THEME_COLOR

RUN yarn build

EXPOSE 80

CMD ["yarn", "dlx", "serve", "-s", "dist", "-l", "80"]
