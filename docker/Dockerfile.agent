FROM golang:1.26.2-alpine AS log-writer-builder

WORKDIR /src

COPY proxy/go.mod proxy/go.sum ./
RUN go mod download

COPY proxy/cmd/agent-log-writer ./cmd/agent-log-writer
COPY proxy/cmd/agent-control ./cmd/agent-control
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /out/log-writer ./cmd/agent-log-writer
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /out/agent-control ./cmd/agent-control

FROM node:24.18.0-slim AS external-service-sdk

WORKDIR /sdk
COPY external-service-sdk/package.json ./
RUN npm install --no-audit --no-fund --no-package-lock --no-save \
    typescript@6.0.3 @types/node@22.19.15 zod@4.5.4 ajv@8.20.0
COPY external-service-sdk/ ./
RUN node scripts/pack-sdk.ts /out

FROM node:24.18.0-slim AS opencode-plugins

WORKDIR /plugins
COPY opencode-plugins/package.json ./
RUN npm install --no-audit --no-fund --no-package-lock --no-save bun@1.4.2
COPY opencode-plugins/ ./
RUN npx tsc --noEmit -p tsconfig.json \
    && for entry in */index.ts; do \
         npx bun build "$entry" --target bun --external effect --external @opencode/plugin \
           --outfile "/out/$(dirname "$entry")/index.js" || exit 1; \
       done

FROM node:24.18.0-slim

ARG OPENCODE_CONFIG=agent-config/opencode.json

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash git curl ca-certificates build-essential python3 unzip less \
    jq nano vim-tiny wget procps tree zip openssh-client python3-pip \
    python3.11-venv ffmpeg \
    sqlite3 \
    pandoc poppler-utils \
    fontconfig fonts-liberation \
    chromium \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libdrm2 libdbus-1-3 libxkbcommon0 libxcomposite1 libxdamage1 \
    libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 \
    libasound2 libatspi2.0-0 libwayland-client0 \
    && rm -rf /var/lib/apt/lists/*

RUN ln -s /usr/bin/python3 /usr/local/bin/python

RUN pip3 install --no-cache-dir --break-system-packages \
    requests Pillow datasette==1.0a28 datasette-write-ui==0.0.1a14 \
    openpyxl==3.1.5 reportlab==5.0.1 pypdf==6.16.1

RUN npm install -g bun @opencode/cli@2.1.2 agent-browser

RUN mkdir -p /opt/doc-tools \
    && npm install --prefix /opt/doc-tools --no-audit --no-fund \
    docx@9.7.1 pptxgenjs@4.0.1 pdf-lib@1.17.1 \
    && ln -s /opt/doc-tools/node_modules /node_modules

RUN corepack enable && corepack prepare yarn@4.17.0 --activate

RUN curl -fsSL https://code-server.dev/install.sh | sh -s -- --version 4.117.0

ARG TARGETARCH=amd64
RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) arch=x86_64; \
        engine_sha=9ac225999fd5e863f7694c728ef23d480616b1e5639328fa309befd4243d69eb; \
        compose_sha=47737f4236e6d3ccea7291995203f8f018058783b4c3a9469119811a0b5db8c0; \
        buildx_sha=e25d5cd675092bb5d1d03632fdc46cdf3fede7b514dc5f023a105e00d3ce5ad4 ;; \
      arm64) arch=aarch64; \
        engine_sha=873b3e0207857c3b2f28392fb922f3ea6efe37620c16d4d4aaf2fef409c90b73; \
        compose_sha=42cfa75f51ad0ccf290bad37899e0038a8c10a0069e85233ecc1d53e3ff1347d; \
        buildx_sha=3b83b3731916ba433feccaaa689fe5bcdc81c641d92c8e6c2ea865dfa141c97a ;; \
      *) echo "Unsupported TARGETARCH ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    apt-get update; \
    apt-get install -y --no-install-recommends iptables; \
    rm -rf /var/lib/apt/lists/*; \
    plugins=/usr/local/lib/docker/cli-plugins; \
    mkdir -p "${plugins}"; \
    curl -fsSLo /tmp/docker.tgz "https://download.docker.com/linux/static/stable/${arch}/docker-29.9.2.tgz"; \
    curl -fsSLo "${plugins}/docker-compose" "https://github.com/docker/compose/releases/download/v5.6.1/docker-compose-linux-${arch}"; \
    curl -fsSLo "${plugins}/docker-buildx" "https://github.com/docker/buildx/releases/download/v0.38.1/buildx-v0.38.1.linux-${TARGETARCH}"; \
    printf '%s  %s\n' \
      "${engine_sha}" /tmp/docker.tgz \
      "${compose_sha}" "${plugins}/docker-compose" \
      "${buildx_sha}" "${plugins}/docker-buildx" | sha256sum -c -; \
    tar -xzf /tmp/docker.tgz -C /usr/local/bin --strip-components=1; \
    rm /tmp/docker.tgz; \
    chmod +x "${plugins}/docker-compose" "${plugins}/docker-buildx"

RUN mkdir -p /workspace /opt/opencode /opt/agents
WORKDIR /workspace

COPY ${OPENCODE_CONFIG} /opt/opencode/opencode.json
COPY agent-config/models.json /opt/opencode/models.json
COPY agent-config/agent-image-version.json /opt/opencode/agent-image-version.json

COPY agent-config/ /opt/agent-config-src/
ENV OPENCODE_MODELS_PATH=/opt/opencode/models.json OPENCODE_DISABLE_MODELS_FETCH=true
RUN cp -a /opt/agent-config-src/agents/. /opt/agents/ \
    && if [ -d /opt/agent-config-src/private/agents ]; then cp -a /opt/agent-config-src/private/agents/. /opt/agents/; fi \
    && mkdir -p /opt/agents/custom \
    && node /opt/agent-config-src/scripts/compose-skills.mjs /opt/agent-config-src/skills /opt/agents \
    && node /opt/agent-config-src/scripts/merge-registry.mjs /opt/agent-config-src/agents.json /opt/agent-config-src/private/agents.json /opt/agents/agents.json \
    && rm -rf /opt/agent-config-src /opt/agents/.gitkeep

COPY --from=external-service-sdk /out/ /opt/opsiforce/external-service-sdk/
COPY external-services/ /opt/opsiforce/external-services-src/
RUN mkdir -p /opt/agents/external-service-builder/reference /opt/agents/external-service-builder/template/app/vendor \
    && find /opt/opsiforce/external-services-src -mindepth 1 -maxdepth 1 -type d \
       -exec cp -a {} /opt/agents/external-service-builder/reference/ \; \
    && rm -rf /opt/opsiforce/external-services-src \
    && cp /opt/opsiforce/external-service-sdk/external-service-sdk-*.tgz /opt/agents/external-service-builder/template/app/vendor/ \
    && chmod -R a-w /opt/opsiforce/external-service-sdk /opt/agents/external-service-builder/reference

COPY --from=opencode-plugins /out/ /opt/opsiforce/opencode-plugins/
RUN chmod -R a-w /opt/opsiforce/opencode-plugins

COPY agent-config/scripts/guard.sh /usr/local/bin/guard
COPY agent-config/scripts/process-logs.sh /usr/local/bin/process-logs
COPY agent-config/scripts/app-url.sh /usr/local/bin/app-url
COPY agent-config/scripts/app-restart.sh /usr/local/bin/app-restart
COPY agent-config/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY agent-config/scripts/agent-workspace-migrate.mjs /usr/local/bin/agent-workspace-migrate
COPY agent-config/datasette-metadata.yml /opt/opencode/datasette-metadata.yml
RUN chmod +x /usr/local/bin/guard /usr/local/bin/process-logs /usr/local/bin/app-url /usr/local/bin/app-restart /usr/local/bin/entrypoint.sh /usr/local/bin/agent-workspace-migrate

RUN apt-get update && apt-get install -y --no-install-recommends \
    ripgrep file \
    && rm -rf /var/lib/apt/lists/*

COPY --from=log-writer-builder /out/log-writer /usr/local/bin/log-writer
COPY --from=log-writer-builder /out/agent-control /usr/local/bin/agent-control
RUN chmod +x /usr/local/bin/log-writer /usr/local/bin/agent-control

ARG EXA_API_KEY=""
ENV EXA_API_KEY=$EXA_API_KEY
ENV NODE_OPTIONS=--max-http-header-size=131072

EXPOSE 4096 3000 8080 8081 4910

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
