# -*- mode: Python -*-

load('ext://restart_process', 'docker_build_with_restart')

# Layout-aware build contexts. The same sources build in two layouts:
#   monorepo  build context = monorepo root, sources under `packages/opsiforce/`
#   standalone build context = package root, that prefix dropped
# The standalone Quickstart (`yarn dev` → up.mjs) sets OPSIFORCE_STANDALONE=1 when it
# launches Tilt; every other caller (e.g. monorepo `yarn dev-opsiforce`) leaves it unset.
is_standalone = os.getenv('OPSIFORCE_STANDALONE') == '1'

build_context = '..' if is_standalone else '../../..'
pkg_prefix = '' if is_standalone else 'packages/opsiforce/'
root_up = '../' if is_standalone else '../../../'
build_args = {'PKG_PREFIX': pkg_prefix}

backend_only = [
    'package.json',
    'yarn.lock',
    '.yarnrc.yml',
    '.yarn/releases',
    pkg_prefix + 'backend',
    pkg_prefix + 'frontend/opencode/packages/protocol/openapi.json',
    pkg_prefix + 'agent-config/agent-image-version.json',
    pkg_prefix + 'agent-config/agents.json',
]
private_registry = pkg_prefix + 'agent-config/private/agents.json'
if os.path.exists(os.path.join(build_context, private_registry)):
    backend_only.append(private_registry)

docker_build(
    'opsiforce-backend',
    context=build_context,
    dockerfile='../docker/Dockerfile.backend.dev',
    build_args=build_args,
    only=backend_only,
    live_update=[
        fall_back_on('./package.json'),
        fall_back_on(root_up + 'package.json'),
        fall_back_on(root_up + 'yarn.lock'),
        fall_back_on(root_up + '.yarnrc.yml'),
        fall_back_on(root_up + '.yarn/releases'),
        sync('./src', '/app/' + pkg_prefix + 'backend/src'),
        sync('./db', '/app/' + pkg_prefix + 'backend/db'),
        sync('../agent-config/agents.json', '/app/' + pkg_prefix + 'agent-config/agents.json'),
    ],
)

def dotenv(path):
    parsed = {}
    for line in str(read_file(path, default='')).splitlines():
        entry = line.strip()
        if not entry or entry.startswith('#') or '=' not in entry:
            continue
        key, _, value = entry.partition('=')
        parsed[key.strip()] = value.strip().strip('"').strip("'")
    return parsed

# Machine-specific values (tunnel host) and real provider secrets live in the
# gitignored .env, never in the tracked values.local.yaml.
BACKEND_ENV_OVERRIDES = {
    'MAILGUN_RECEIVE_DOMAIN': 'config.mailgunReceiveDomain',
    'MAILGUN_WEBHOOK_SIGNING_KEY': 'config.mailgunWebhookSigningKey',
    'EXTERNAL_SERVICES_WEBHOOK_BASE_URL': 'config.externalServicesWebhookBaseUrl',
}

local_env = dotenv('../.env')
backend_overrides = []
for env_key, helm_key in BACKEND_ENV_OVERRIDES.items():
    if local_env.get(env_key):
        backend_overrides.append(helm_key + '=' + local_env[env_key])

k8s_yaml(helm(
    '../helm/opsiforce-backend',
    name='opsiforce-backend',
    namespace='local',
    values=['../helm/opsiforce-backend/values.local.yaml'],
    set=backend_overrides,
))

k8s_resource(
    'opsiforce-backend',
    port_forwards=[
        '3010:3001',
        '9229:9229',
    ],
    labels=['cluster'],
)

# ───────────────────────── Gotenberg document converter ─────────────────────────
# Shared office-to-PDF converter behind the docx/pptx preview. Third-party image, so
# nothing to build or live-update; deployed here rather than in the infra step so a
# `tilt up` reconciles it on every run.
k8s_yaml(helm(
    '../helm/opsiforce-gotenberg',
    name='opsiforce-gotenberg',
    namespace='local',
    values=['../helm/opsiforce-gotenberg/values.local.yaml'],
))

k8s_resource(
    'opsiforce-gotenberg',
    labels=['cluster'],
)

# ───────────────────────── Runtime proxies ─────────────────────────
# Go binaries (mode={agent,app,vscode,db}). Deployed in the same namespace
# as backend + agents so RBAC stays namespaced and service references
# resolve via short name.
docker_build_with_restart(
    'opsiforce-runtime-proxy',
    context=build_context,
    dockerfile='../docker/Dockerfile.runtime-proxy.dev',
    build_args=build_args,
    entrypoint=['/usr/local/bin/opsiforce-proxy'],
    only=[pkg_prefix + 'proxy'],
    live_update=[
        sync('../proxy', '/src/packages/opsiforce/proxy'),
        run('cd /src/packages/opsiforce/proxy && go build -o /usr/local/bin/opsiforce-proxy ./cmd/opsiforce-proxy'),
    ],
)

k8s_yaml(helm(
    '../helm/opsiforce-runtime-proxies',
    name='proxy',
    namespace='local',
    values=['../helm/opsiforce-runtime-proxies/values.local.yaml'],
))

# Group all four proxy deployments under one Tilt resource for tidier UI.
k8s_resource(
    workload='proxy-agent',
    new_name='runtime-proxies',
    objects=[
        'proxy:serviceaccount',
        'proxy-config:configmap',
        'proxy-secret:secret',
    ],
    labels=['cluster'],
)
k8s_resource(workload='proxy-app', new_name='runtime-proxies-app', labels=['cluster'])
k8s_resource(workload='proxy-vscode', new_name='runtime-proxies-vscode', labels=['cluster'])
k8s_resource(workload='proxy-db', new_name='runtime-proxies-db', labels=['cluster'])

# ───────────────────────── Opsiforce Proxy (Traefik routing + oauth2-proxy) ─────────────────────────
# Depends on the runtime-proxies Services existing so nginx's startup-time DNS
# resolution doesn't fail. Uses prod nginx image (no source to live-reload).
k8s_yaml(helm(
    '../helm/opsiforce-proxy',
    name='opsiforce-proxy',
    namespace='local',
    values=['../helm/opsiforce-proxy/values.local.yaml'],
))

k8s_resource(
    'opsiforce-proxy',
    resource_deps=[
        'runtime-proxies-app',
        'runtime-proxies-vscode',
        'runtime-proxies-db',
        'opsiforce-backend',
    ],
    labels=['cluster'],
)

# ───────────────────────── Tilt UI exposed via Traefik ─────────────────────────
# Routes https://tilt.opsiforce.localtest.me to the host's `tilt up` web UI on
# :10350 via an ExternalName service. Requires `tilt up --host=0.0.0.0` so the
# UI is reachable from inside the cluster.
k8s_yaml(blob("""
apiVersion: v1
kind: Service
metadata:
  name: tilt-ui
  namespace: local
spec:
  type: ExternalName
  externalName: host.minikube.internal
  ports:
    - port: 10350
      targetPort: 10350
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: tilt-ui
  namespace: local
spec:
  entryPoints: [websecure]
  routes:
    - match: Host(`tilt.opsiforce.localtest.me`)
      kind: Rule
      services:
        - name: tilt-ui
          port: 10350
  tls: {}
"""))

# ───────────────────────── Host-side processes (local_resource) ─────────────────────────
# Long-running host processes Tilt manages next to the in-cluster workloads, so the whole
# stack lives under one UI with per-process logs/status/restart. The cluster reaches these
# over host.minikube.internal (the frontend via opsiforce-proxy nginx; the codex proxy via
# Bifrost; the mail mock via the backend).

# Frontend dev server (Vite, :8084). opsiforce-proxy proxies the web app here; `/api` is
# served by the in-cluster backend with the static dev identity, so the UI loads signed in.
# Standalone-only: the monorepo `yarn dev-opsiforce` flow already starts @opsiforce/frontend
# via `dev-opsiforce-only`, so launching it here too would collide on port 8084.
if is_standalone:
    local_resource(
        'frontend',
        serve_cmd='yarn workspace @opsiforce/frontend run minikube-dev',
        readiness_probe=probe(period_secs=5, http_get=http_get_action(port=8084, path='/')),
        labels=['host'],
    )

# Codex proxy (:8455) only matters on the subscription LLM path; on the OpenAI-key path
# Bifrost calls api.openai.com directly. The Quickstart records the choice in the config.
config_path = os.path.join(os.getenv('HOME', ''), '.opsiforce', 'config.json')
llm_provider = 'subscription'
if os.path.exists(config_path):
    cfg = read_json(config_path, default={})
    llm = cfg.get('llm', {})
    if type(llm) == 'dict':
        llm_provider = llm.get('provider', 'subscription')

if llm_provider != 'key':
    local_resource(
        'codex-proxy',
        serve_cmd='CODEX_PROXY_PORT=8455 yarn workspace @opsiforce/codex-proxy run start',
        readiness_probe=probe(period_secs=5, http_get=http_get_action(port=8455, path='/healthz')),
        labels=['host'],
    )

# Host access to the in-cluster data stores for psql / redis-cli / a DB GUI. The backend
# reaches them in-cluster, so these forwards are a developer convenience; the loop keeps
# them alive across the occasional port-forward drop.
local_resource(
    'pg-forward',
    serve_cmd='while true; do kubectl port-forward -n local svc/local-pg-postgresql 5435:5432; sleep 1; done',
    readiness_probe=probe(period_secs=10, tcp_socket=tcp_socket_action(5435)),
    labels=['data'],
)
local_resource(
    'redis-forward',
    serve_cmd='while true; do kubectl port-forward -n local svc/redis-session-storage-local-master 6382:6379; sleep 1; done',
    readiness_probe=probe(period_secs=10, tcp_socket=tcp_socket_action(6382)),
    labels=['data'],
)

if is_standalone:
    local_resource(
        'drizzle-studio',
        serve_cmd='set -a; . ./local-envs.sh; set +a; yarn exec drizzle-kit studio',
        readiness_probe=probe(period_secs=10, tcp_socket=tcp_socket_action(4983)),
        resource_deps=['pg-forward'],
        labels=['data'],
    )

# Optional mail stub that swallows the backend's outbound mail. Off unless the wizard's
# email-testing step opted in (config.emailTesting); startable from the Tilt UI any time.
email_testing = False
if os.path.exists(config_path):
    email_testing = read_json(config_path, default={}).get('emailTesting', False) == True

local_resource(
    'mail-mock',
    serve_cmd='node ../scripts/mail-mock.mjs',
    readiness_probe=probe(period_secs=10, http_get=http_get_action(port=8089, path='/healthz')),
    auto_init=email_testing,
    labels=['optional'],
)
