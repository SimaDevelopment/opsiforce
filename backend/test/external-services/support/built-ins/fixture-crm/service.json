{
  "sdk": 2,
  "displayName": "Fixture CRM",
  "description": "A pretend CRM that the backend tests configure and call.",
  "icon": "icon.svg",
  "serviceForm": [
    {
      "key": "baseUrl",
      "was": "apiUrl",
      "type": "text",
      "label": "API URL",
      "required": true,
      "validate": {
        "format": "url"
      }
    },
    {
      "key": "region",
      "type": "select",
      "label": "Region",
      "required": true,
      "options": [
        {
          "value": "eu",
          "label": "Europe"
        },
        {
          "value": "us",
          "label": "United States"
        }
      ]
    },
    {
      "key": "apiKey",
      "type": "secret",
      "label": "API key",
      "required": true
    },
    {
      "key": "connection",
      "type": "info",
      "label": "Connection",
      "call": "connectionStatus"
    },
    {
      "type": "section",
      "title": "Advanced",
      "collapsed": true,
      "fields": [
        {
          "key": "timeoutSeconds",
          "type": "number",
          "label": "Timeout (seconds)",
          "min": 1,
          "max": 60,
          "integer": true
        }
      ]
    },
    {
      "key": "mailboxes",
      "type": "list",
      "label": "Mailboxes",
      "item": [
        {
          "key": "label",
          "type": "text",
          "label": "Label",
          "required": true
        },
        {
          "key": "token",
          "type": "secret",
          "label": "Token",
          "required": true
        },
        {
          "key": "test",
          "type": "button",
          "label": "Test mailbox",
          "call": "testMailbox"
        }
      ]
    }
  ],
  "projectForm": [
    {
      "key": "mailbox",
      "type": "select",
      "label": "Mailbox",
      "required": true,
      "options": {
        "serviceConfiguration": "mailboxes",
        "labelKey": "label"
      }
    },
    {
      "key": "pipeline",
      "type": "select",
      "label": "Pipeline",
      "options": [
        {
          "value": "sales",
          "label": "Sales"
        },
        {
          "value": "support",
          "label": "Support"
        }
      ]
    },
    {
      "key": "inboxAddress",
      "type": "info",
      "label": "Inbox address",
      "template": "{{pipeline}}@{{serviceConfiguration.region}}.inbox.test"
    },
    {
      "key": "signingSecret",
      "type": "secret",
      "label": "Signing secret"
    },
    {
      "key": "accountsMode",
      "type": "radio",
      "label": "Accounts",
      "default": "selected",
      "options": [
        {
          "value": "selected",
          "label": "Selected accounts"
        },
        {
          "value": "all",
          "label": "All accounts"
        }
      ]
    },
    {
      "key": "accountIds",
      "type": "multiselect",
      "label": "Accounts",
      "visibleWhen": {
        "field": "accountsMode",
        "equals": "selected"
      },
      "options": {
        "call": "listAccounts",
        "searchable": true
      }
    },
    {
      "key": "accountsSummary",
      "type": "info",
      "label": "Accounts summary",
      "call": "accountsSummary"
    },
    {
      "key": "teams",
      "type": "list",
      "label": "Teams",
      "item": [
        {
          "key": "team",
          "type": "select",
          "label": "Team",
          "required": true,
          "options": [
            {
              "value": "red",
              "label": "Red team"
            },
            {
              "value": "blue",
              "label": "Blue team"
            }
          ]
        },
        {
          "key": "memberIds",
          "type": "multiselect",
          "label": "Members",
          "options": {
            "call": "listMembers",
            "dependsOn": [
              "team"
            ]
          }
        }
      ]
    },
    {
      "key": "invite",
      "type": "button",
      "label": "Send a test invite",
      "call": "sendInvite",
      "confirm": "Send a test invite to the picked mailbox?"
    }
  ]
}
