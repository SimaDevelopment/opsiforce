{
  "sdk": 2,
  "displayName": "GitHub",
  "description": "Issues and pull requests on the repositories a Project is given.",
  "serviceForm": [
    {
      "key": "appId",
      "type": "text",
      "label": "App id",
      "required": true
    },
    {
      "key": "privateKey",
      "type": "secret",
      "label": "Private key",
      "required": true
    }
  ],
  "projectForm": [
    {
      "key": "repositories",
      "type": "list",
      "label": "Repositories",
      "item": [
        {
          "key": "repositoryId",
          "type": "text",
          "label": "Repository",
          "required": true
        },
        {
          "key": "access",
          "type": "select",
          "label": "Access",
          "default": "read",
          "options": [
            {
              "value": "read",
              "label": "Read"
            },
            {
              "value": "pull_request",
              "label": "Pull request"
            },
            {
              "value": "write",
              "label": "Write"
            }
          ]
        }
      ]
    }
  ]
}
