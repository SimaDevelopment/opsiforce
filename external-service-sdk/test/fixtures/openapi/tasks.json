{
  "openapi": "3.1.0",
  "info": {
    "title": "Tasks API",
    "description": "Track the team's tasks. Every call needs an API key.",
    "version": "1"
  },
  "servers": [{ "url": "https://tasks.example.com" }],
  "paths": {
    "/v1/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "List tasks",
        "description": "Every open task, newest first.",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
          { "name": "x-request-id", "in": "header", "schema": { "type": "string" } }
        ]
      },
      "post": {
        "operationId": "createTask",
        "summary": "Create a task",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewTask" } } }
        }
      }
    },
    "/v1/tasks/{taskId}": {
      "parameters": [{ "name": "taskId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f-]+$" } }],
      "get": { "operationId": "getTask", "summary": "Get a task" },
      "delete": { "operationId": "deleteTask", "summary": "Delete a task" }
    },
    "/v1/tasks/{taskId}/archive": {
      "post": {
        "summary": "Archive a task",
        "parameters": [{ "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } }]
      }
    }
  },
  "components": {
    "schemas": {
      "NewTask": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
          "assignee": { "anyOf": [{ "$ref": "#/components/schemas/Person" }, { "type": "null" }] },
          "labels": { "type": "array", "items": { "type": "string" }, "example": ["urgent"] }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "Person": {
        "type": "object",
        "properties": { "email": { "type": "string", "format": "email" }, "id": { "type": "string", "format": "int64" } },
        "required": ["email"]
      }
    }
  }
}
