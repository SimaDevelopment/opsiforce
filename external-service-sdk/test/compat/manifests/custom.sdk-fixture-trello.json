{
  "$schema": "https://opsiforce.dev/schemas/service.schema.json",
  "sdk": 1,
  "displayName": "Trello",
  "description": "Read and update cards on your Trello boards.",
  "icon": "icon.svg",
  "inbound": true,
  "serviceForm": [
    {
      "key": "workspaces",
      "type": "list",
      "item": [
        { "key": "label", "type": "text", "required": true },
        { "key": "apiKey", "type": "secret" },
        { "key": "apiSecret", "type": "secret" },
        { "key": "token", "type": "secret" },
        { "key": "test", "type": "button", "label": "Test connection", "call": "ping" }
      ]
    },
    { "key": "callback", "type": "info", "template": "{{webhookUrl}}" }
  ],
  "projectForm": [
    {
      "key": "workspace",
      "type": "select",
      "required": true,
      "options": { "serviceConfiguration": "workspaces", "labelKey": "label" }
    },
    {
      "key": "boardsMode",
      "type": "radio",
      "default": "selected",
      "options": [
        { "value": "selected", "label": "Selected boards" },
        { "value": "all", "label": "All boards" }
      ]
    },
    {
      "key": "boardIds",
      "was": "boards",
      "type": "multiselect",
      "visibleWhen": { "field": "boardsMode", "equals": "selected" },
      "options": { "call": "listBoards", "dependsOn": ["workspace"], "searchable": true }
    }
  ],
  "operations": {
    "list_cards": {
      "kind": "read",
      "description": "List the cards on an allowed board.",
      "input": { "$ref": "#/$defs/ListCards" }
    },
    "create_card": {
      "kind": "write",
      "title": "Create card",
      "description": "Create a card in a list on an allowed board. Returns the new card.",
      "input": { "$ref": "#/$defs/CreateCard" },
      "outputExample": { "id": "6523f1", "url": "https://trello.com/c/AbC123" }
    },
    "delete_card": {
      "kind": "destructive",
      "description": "Delete a card from an allowed board.",
      "input": { "$ref": "#/$defs/DeleteCard" },
      "limits": { "timeoutSeconds": 60 }
    }
  },
  "events": {
    "card.moved": {
      "title": "Card moved",
      "description": "A card moved to another list.",
      "data": {
        "type": "object",
        "properties": {
          "boardId": { "type": "string", "maxLength": 64, "boundTo": "board" },
          "cardId": { "type": "string", "maxLength": 64 }
        },
        "required": ["boardId", "cardId"]
      }
    }
  },
  "bounds": {
    "board": { "path": "boardIds", "unless": { "boardsMode": "all" } }
  },
  "$defs": {
    "ListCards": {
      "type": "object",
      "properties": {
        "boardId": { "type": "string", "maxLength": 64, "boundTo": "board" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "required": ["boardId"],
      "additionalProperties": false
    },
    "CreateCard": {
      "type": "object",
      "properties": {
        "boardId": { "type": "string", "maxLength": 64, "boundTo": "board" },
        "listId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "labels": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 64 } }
      },
      "required": ["boardId", "listId", "name"],
      "additionalProperties": false
    },
    "DeleteCard": {
      "type": "object",
      "properties": {
        "boardId": { "type": "string", "maxLength": 64, "boundTo": "board" },
        "cardId": { "type": "string", "maxLength": 64 }
      },
      "required": ["boardId", "cardId"],
      "additionalProperties": false
    }
  }
}
