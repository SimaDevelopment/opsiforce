{
  "sdk": 1,
  "displayName": "Incoming email",
  "description": "Receive email sent to a Project's own address.",
  "inbound": true,
  "serviceForm": [
    {
      "key": "receivingDomain",
      "type": "text",
      "label": "Receiving domain",
      "required": true,
      "validate": { "format": "hostname" }
    },
    { "key": "signingKey", "type": "secret", "label": "Webhook signing key", "required": true },
    {
      "key": "maxAttachmentMb",
      "type": "number",
      "label": "Largest attachment (MB)",
      "default": 25,
      "min": 1,
      "max": 25,
      "integer": true
    }
  ],
  "projectForm": [
    {
      "key": "localPart",
      "type": "text",
      "label": "Address",
      "generate": { "length": 16, "alphabet": "lowercaseAlphanumeric", "unique": true }
    },
    {
      "key": "address",
      "type": "info",
      "label": "Email address",
      "template": "{{localPart}}@{{serviceConfiguration.receivingDomain}}"
    }
  ],
  "events": {
    "email.received": {
      "title": "Email received",
      "description": "An email arrived at the Project's address.",
      "data": {
        "type": "object",
        "properties": {
          "address": { "type": "string", "maxLength": 64, "boundTo": "address" },
          "from": { "type": "string", "maxLength": 320 },
          "subject": { "type": "string", "maxLength": 1000 },
          "text": { "type": "string" },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "filename": { "type": "string" },
                "mimeType": { "type": "string" },
                "size": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "required": ["address", "from"]
      }
    }
  },
  "bounds": {
    "address": { "path": "localPart" }
  }
}
