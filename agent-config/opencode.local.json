{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "-opencode.provider.opencode"
  ],
  "update": "disable",
  "snapshots": false,
  "websearch": {
    "provider": "exa"
  },
  "agents": {
    "build": {
      "disabled": true
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": ".opencode/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".opsiforce/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "data/database.db",
      "effect": "deny"
    }
  ],
  "providers": {
    "anthropic": {
      "models": {
        "claude-opus-5": {
          "settings": {
            "reasoningEffort": "high"
          }
        },
        "claude-sonnet-5": {
          "settings": {
            "reasoningEffort": "high"
          }
        },
        "claude-haiku-4-5": {}
      },
      "settings": {
        "baseURL": "{env:ANTHROPIC_BASE_URL}"
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": {
            "context": 290400,
            "output": 32000
          },
          "settings": {
            "reasoningEffort": "high"
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh"
              }
            }
          ]
        },
        "gpt-5.6-sol-fast": {
          "limit": {
            "context": 290400,
            "output": 32000
          },
          "settings": {
            "reasoningEffort": "high"
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh"
              }
            }
          ]
        },
        "gpt-6-astra": {
          "limit": {
            "context": 290400,
            "output": 32000
          },
          "settings": {
            "reasoningEffort": "high"
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh"
              }
            }
          ]
        }
      },
      "settings": {
        "baseURL": "{env:OPENAI_BASE_URL}"
      }
    }
  },
  "model": "openai/gpt-5.6-sol"
}
