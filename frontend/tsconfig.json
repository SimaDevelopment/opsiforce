{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./opencode/packages/app/src/*"],
      "@opencode/app": ["./opencode/packages/app/src/index.ts"],
      "@opencode/app/*": ["./opencode/packages/app/src/*"],
      "@opencode/app/desktop-menu": ["./opencode/packages/app/src/shell/commands/desktop-menu.ts"],
      "@opencode/app/i18n/desktop-native": ["./opencode/packages/app/src/runtime/i18n/desktop-native.ts"],
      "@opencode/ui/*": ["./opencode/packages/ui/src/*", "./opencode/packages/ui/src/components/*"],
      "@opencode/ui/accordion": ["./opencode/packages/ui/src/data-display/accordion/accordion.tsx"],
      "@opencode/ui/avatar": ["./opencode/packages/ui/src/data-display/avatar/avatar.tsx"],
      "@opencode/ui/badge": ["./opencode/packages/ui/src/data-display/badge/badge.tsx"],
      "@opencode/ui/button": ["./opencode/packages/ui/src/actions/button/button.tsx"],
      "@opencode/ui/checkbox": ["./opencode/packages/ui/src/forms/checkbox/checkbox.tsx"],
      "@opencode/ui/dialog": ["./opencode/packages/ui/src/overlays/dialog/dialog.tsx"],
      "@opencode/ui/diff-changes": ["./opencode/packages/ui/src/data-display/diff-changes/diff-changes.tsx"],
      "@opencode/ui/divider": ["./opencode/packages/ui/src/layout/divider/divider.tsx"],
      "@opencode/ui/field": ["./opencode/packages/ui/src/forms/field/field.tsx"],
      "@opencode/ui/icon": ["./opencode/packages/ui/src/icons/icon/icon.tsx"],
      "@opencode/ui/icon-button": ["./opencode/packages/ui/src/actions/icon-button/icon-button.tsx"],
      "@opencode/ui/inline-input": ["./opencode/packages/ui/src/forms/inline-input/inline-input.tsx"],
      "@opencode/ui/keybind": ["./opencode/packages/ui/src/data-display/keybind/keybind.tsx"],
      "@opencode/ui/line-comment": ["./opencode/packages/ui/src/data-display/line-comment/line-comment.tsx"],
      "@opencode/ui/loader": ["./opencode/packages/ui/src/feedback/loader/loader.tsx"],
      "@opencode/ui/menu": ["./opencode/packages/ui/src/navigation/menu/menu.tsx"],
      "@opencode/ui/progress-circle": ["./opencode/packages/ui/src/feedback/progress-circle/progress-circle.tsx"],
      "@opencode/ui/project-avatar": ["./opencode/packages/ui/src/data-display/project-avatar/project-avatar.tsx"],
      "@opencode/ui/radio": ["./opencode/packages/ui/src/forms/radio/radio.tsx"],
      "@opencode/ui/segmented-control": ["./opencode/packages/ui/src/navigation/segmented-control/segmented-control.tsx"],
      "@opencode/ui/select": ["./opencode/packages/ui/src/forms/select/select.tsx"],
      "@opencode/ui/split-button": ["./opencode/packages/ui/src/actions/split-button/split-button.tsx"],
      "@opencode/ui/switch": ["./opencode/packages/ui/src/forms/switch/switch.tsx"],
      "@opencode/ui/tab-state-indicator": ["./opencode/packages/ui/src/navigation/tab-state-indicator.tsx"],
      "@opencode/ui/tabs": ["./opencode/packages/ui/src/navigation/tabs/tabs.tsx"],
      "@opencode/ui/text-input": ["./opencode/packages/ui/src/forms/text-input/text-input.tsx"],
      "@opencode/ui/textarea": ["./opencode/packages/ui/src/forms/textarea/textarea.tsx"],
      "@opencode/ui/text-shimmer": ["./opencode/packages/ui/src/typography/text-shimmer/text-shimmer.tsx"],
      "@opencode/ui/toast": ["./opencode/packages/ui/src/feedback/toast/toast.tsx"],
      "@opencode/ui/tooltip": ["./opencode/packages/ui/src/overlays/tooltip/tooltip.tsx"],
      "@opencode/ui/wordmark": ["./opencode/packages/ui/src/typography/wordmark/wordmark.tsx"],
      "@opencode/ui/icons/provider": ["./opencode/packages/ui/src/components/provider-icons/types.ts"],
      "@opencode/ui/icons/file-type": ["./opencode/packages/ui/src/components/file-icons/types.ts"],
      "@opencode/ui/icons/app": ["./opencode/packages/ui/src/components/app-icons/types.ts"],
      "@opencode/core/*": ["./opencode/packages/core/src/*"],
      "@opencode/schema/*": ["./opencode/packages/schema/src/*"],
      "@opencode/schema": ["./opencode/packages/schema/src/index.ts"],
      "@opencode/session-ui/*": ["./opencode/packages/session-ui/src/*", "./opencode/packages/session-ui/src/components/*"],
      "@opencode/session-ui/message": ["./opencode/packages/session-ui/src/message/current-message.tsx"],
      "@opencode/session-ui/timeline/row": ["./opencode/packages/session-ui/src/timeline/session-timeline-row.tsx"],
      "@opencode/session-ui/timeline": ["./opencode/packages/session-ui/src/timeline/session-timeline.tsx"],
      "@opencode/session-ui/attachment-card": ["./opencode/packages/session-ui/src/message/attachment-card.tsx"],
      "@opencode/session-ui/comment-card": ["./opencode/packages/session-ui/src/message/comment-card.tsx"],
      "@opencode/session-ui/v2/*": ["./opencode/packages/session-ui/src/v2/components/*"],
      "@opencode/plugin/*": ["./opencode/packages/plugin/src/*"],
      "@opencode/client": ["./opencode/packages/client/src/promise/index.ts"],
      "@opencode/client/*": ["./opencode/packages/client/src/*"],
      "@opencode/client/service": ["./opencode/packages/client/src/promise/service.ts"],
      "@opencode/util/*": ["./opencode/packages/util/src/*"],
      "@opencode/theme/*": ["./opencode/packages/theme/src/*"],
      "@opencode/protocol/*": ["./opencode/packages/protocol/src/*"],
      "@opencode/sdk": ["./opencode/packages/sdk/src/index.ts"],
      "@opencode/sdk/*": ["./opencode/packages/sdk/src/*"],
      "@opencode/gui-extensions/updater": ["./opencode/packages/gui-extensions/src/updater/contract.ts"],
      "@opencode/gui-extensions/*": ["./opencode/packages/gui-extensions/src/*"],
      "@opencode/plugin-browser": ["./opencode/packages/plugin-browser/src/index.ts"],
      "@opencode/plugin-browser/*": ["./opencode/packages/plugin-browser/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
